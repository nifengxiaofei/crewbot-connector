{
  "name": "crewbot",
  "version": "0.2.6",
  "description": "Run the coding agents on your computers from anywhere — the local daemon for super-agent.team",
  "keywords": [
    "crewbot",
    "claude-code",
    "codex",
    "grok",
    "agent",
    "acp",
    "agent-client-protocol",
    "remote",
    "cli"
  ],
  "homepage": "https://super-agent.team",
  "license": "MIT",
  "author": "nifengfei",
  "type": "module",
  "bin": {
    "crewbot": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.99.1",
    "@crewbot/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
